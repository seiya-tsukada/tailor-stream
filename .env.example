# .env にコピーして使う（.env は gitignore 済み）。秘密情報に VITE_ 接頭辞を付けないこと
# docker compose で起動する場合 .env は不要（DATABASE_URL などは docker-compose.yml の値を使う）

# 記事の取得元: mock | google_alerts_rss（デフォルト: mock）
# mock なら下の DATABASE_URL・ADMIN_SECRET・メール設定はすべて省略できる（足りない機能だけ無効になる）
NEWS_PROVIDER=mock

# --- mock 以外では必須 ---

# データの保存先: postgres | memory（未設定なら DATABASE_URL があれば postgres、無ければ memory）
# memory は DB を使わないモック（Supabase を用意する前のデプロイ用。mock 以外でも明示すれば使える）。
# データはプロセスのメモリにしか残らない（再起動・Vercel のインスタンスをまたいで消える）
# DATA_BACKEND=

# DATA_BACKEND=postgres のとき必須。
# Supabase（Postgres）への接続文字列。Supavisor の Transaction mode（ポート 6543）を使い、
# ユーザーは DB のオーナーロール（postgres）にする（Supabase の Connect 画面の Transaction pooler の値）
# 例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 管理 API（/api/admin/*）の Bearer トークン。16文字以上のランダムな値（未設定なら管理 API は 503）
ADMIN_SECRET=

# --- 任意 ---

# フロントの URL（スキーム + ホスト[:ポート]）。ログインリンク・Origin チェック・Cookie の Secure 判定に使う
# 未設定なら Vercel の VERCEL_PROJECT_PRODUCTION_URL（本番ドメイン）、それも無ければ http://localhost:5173
# APP_BASE_URL=

# ログインリンクのメール送信: console | resend | noop
# 未設定なら resend（RESEND_API_KEY と EMAIL_FROM がそろっていれば）→ console（ローカルのみ）の順に選ぶ。
# どちらも使えなければログイン機能だけが無効（503）になる
# console はリンクをサーバーのログに出すだけ（フロントの URL が localhost のときだけ使える）
# noop は何も送らずリンクもログに出さないモック（明示したときだけ使う。ログインはできない）
# EMAIL_PROVIDER=
# EMAIL_PROVIDER=resend のときに必要
# RESEND_API_KEY=
# EMAIL_FROM=TailorStream <login@example.com>

# セッションの有効期限（日、デフォルト: 30）
SESSION_TTL_DAYS=30

# カテゴリ ID → Google アラートの RSS URL（JSON）。未設定のカテゴリは取り込みをスキップする
# GOOGLE_ALERTS_FEEDS={"ai":"https://www.google.com/alerts/feeds/...","web3":"https://www.google.com/alerts/feeds/..."}

# 記事を一覧に出す時間（公開時刻からの時間、デフォルト: 48）
ARTICLE_TTL_HOURS=48

# RSS 取得のタイムアウト（秒、デフォルト: 10）と User-Agent
RSS_TIMEOUT_SECONDS=10
# RSS_USER_AGENT=

# DB 接続のタイムアウト（秒、デフォルト: 10）
DB_CONNECT_TIMEOUT_SECONDS=10

# pytest で実 DB を使うテストを実行するときの接続先（未設定ならスキップ）
# TEST_DATABASE_URL=
# 例（docker compose の DB）: postgresql://postgres:postgres@localhost:54330/tailor_stream_test

# --- docker compose のホスト側ポート（任意） ---
# WEB_PORT=5180
# API_PORT=8000
# DB_PORT=54330
